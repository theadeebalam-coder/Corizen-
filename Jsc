import React, { useState, useEffect } from 'react';

const App = () => {
  // Products State - LocalStorage se data load karega
  const [products, setProducts] = useState(() => {
    const saved = localStorage.getItem('corizen_products');
    return saved ? JSON.parse(saved) : [
      { id: 1, name: 'Premium Journal', price: 499, desc: 'Handmade in India', stock: 15, img: 'https://cdn-icons-png.flaticon.com/512/3342/3342137.png' }
    ];
  });

  const [isAdmin, setIsAdmin] = useState(false);
  const [showAddModal, setShowAddModal] = useState(false);
  const [newProduct, setNewProduct] = useState({ name: '', price: '', desc: '', stock: '', img: '' });

  // Save to LocalStorage whenever products change
  useEffect(() => {
    localStorage.setItem('corizen_products', JSON.stringify(products));
  }, [products]);

  // Admin Actions
  const addProduct = () => {
    setProducts([...products, { ...newProduct, id: Date.now() }]);
    setShowAddModal(false);
    setNewProduct({ name: '', price: '', desc: '', stock: '', img: '' });
  };

  const deleteProduct = (id) => setProducts(products.filter(p => p.id !== id));

  return (
    <div className="bg-[#FAF9F6] min-h-screen font-sans pb-24">
      {/* --- HEADER --- */}
      <header className="p-5 flex justify-between items-center bg-white sticky top-0 z-10 shadow-sm">
        <div className="flex items-center gap-2">
          <div className="w-10 h-10 bg-[#1A362D] rounded-full flex items-center justify-center text-white font-serif">C</div>
          <div className="leading-none">
            <h1 className="font-bold text-xl tracking-tight text-[#1A362D]">Corizen</h1>
            <p className="text-[10px] uppercase tracking-widest text-gray-400 font-medium">Elite Stationery</p>
          </div>
        </div>
        <div className="flex gap-4 items-center">
          <button onClick={() => setIsAdmin(!isAdmin)} className="text-xs font-semibold px-3 py-1 border rounded-full hover:bg-gray-100">
            {isAdmin ? '🔴 Admin Mode' : '⚪ User View'}
          </button>
        </div>
      </header>

      {/* --- MAIN SECTION --- */}
      <main className="p-6 max-w-lg mx-auto">
        <div className="mt-8 mb-10">
          <h2 className="text-[42px] font-bold leading-[1.1] text-black">Curating your</h2>
          <h2 className="text-[42px] font-bold leading-[1.1] text-gray-300">perfect desk.</h2>
        </div>

        {/* Search Bar */}
        <div className="relative mb-12">
          <input 
            type="text" 
            placeholder="Search the collection..." 
            className="w-full py-4 px-6 rounded-2xl bg-white border border-gray-100 shadow-sm focus:ring-2 ring-green-100 outline-none transition-all"
          />
        </div>

        {/* Admin: Add Button */}
        {isAdmin && (
          <button 
            onClick={() => setShowAddModal(true)}
            className="w-full mb-8 bg-green-800 text-white py-4 rounded-2xl font-bold shadow-lg"
          >
            + Add New Product
          </button>
        )}

        {/* Product Grid */}
        <div className="grid grid-cols-1 gap-10">
          {products.map(product => (
            <div key={product.id} className="relative group">
              <div className="bg-[#F3F4EF] rounded-[45px] p-16 flex justify-center items-center overflow-hidden h-80">
                <img src={product.img} alt={product.name} className="w-32 object-contain group-hover:scale-110 transition-transform duration-500" />
              </div>
              
              <div className="mt-6 flex justify-between items-start px-4">
                <div>
                  <h3 className="font-bold text-xl">{product.name}</h3>
                  <p className="text-gray-400 text-xs uppercase tracking-widest mt-1 font-semibold">{product.desc}</p>
                  <p className="text-green-700 text-xs mt-1">Stock: {product.stock}</p>
                </div>
                <p className="font-bold text-2xl text-[#1A362D]">₹{product.price}</p>
              </div>

              {isAdmin && (
                <button 
                  onClick={() => deleteProduct(product.id)}
                  className="absolute top-4 right-4 bg-red-500 text-white p-2 rounded-full text-xs"
                >
                  Delete
                </button>
              )}
            </div>
          ))}
        </div>
      </main>

      {/* --- FLOATING NAV --- */}
      <nav className="fixed bottom-6 left-1/2 -translate-x-1/2 bg-[#0C0C0C] text-white px-10 py-4 rounded-full flex gap-16 shadow-2xl items-center">
        <button className="opacity-100 scale-110">🏠</button>
        <button className="opacity-50">👤</button>
        <button className="opacity-50 relative">
          🛒
          <span className="absolute -top-1 -right-2 bg-green-500 text-[10px] w-4 h-4 rounded-full flex items-center justify-center">0</span>
        </button>
      </nav>

      {/* --- ADMIN MODAL --- */}
      {showAddModal && (
        <div className="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-6">
          <div className="bg-white w-full max-w-md rounded-[30px] p-8 shadow-2xl">
            <h2 className="text-2xl font-bold mb-6">Add Product</h2>
            <div className="space-y-4">
              <input type="text" placeholder="Product Name" className="w-full p-3 border rounded-xl" onChange={e => setNewProduct({...newProduct, name: e.target.value})} />
              <input type="number" placeholder="Price" className="w-full p-3 border rounded-xl" onChange={e => setNewProduct({...newProduct, price: e.target.value})} />
              <input type="text" placeholder="Sub-heading (e.g. Handmade)" className="w-full p-3 border rounded-xl" onChange={e => setNewProduct({...newProduct, desc: e.target.value})} />
              <input type="number" placeholder="Stock Quantity" className="w-full p-3 border rounded-xl" onChange={e => setNewProduct({...newProduct, stock: e.target.value})} />
              <input type="text" placeholder="Image URL (Link)" className="w-full p-3 border rounded-xl" onChange={e => setNewProduct({...newProduct, img: e.target.value})} />
            </div>
            <div className="flex gap-4 mt-8">
              <button onClick={() => setShowAddModal(false)} className="flex-1 py-3 bg-gray-100 rounded-xl font-bold">Cancel</button>
              <button onClick={addProduct} className="flex-1 py-3 bg-green-900 text-white rounded-xl font-bold">Save Item</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default App;
